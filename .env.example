# ============ OpenKey environment ============
# Copy to `.env` and fill in. Every variable is documented on one line.

# --- Core ---
NODE_ENV=production                     # "development" | "production" — production refuses default/missing secrets
OPENKEY_PORT=4000                       # Port the gateway + control-plane API listens on
LOG_LEVEL=info                          # pino level: trace | debug | info | warn | error

# --- Security (REQUIRED) ---
OPENKEY_MASTER_KEY=                     # 32-byte hex (64 chars) AES-256-GCM key for provider credentials at rest — generate: `openssl rand -hex 32`
OPENKEY_JWT_SECRET=                     # Secret for signing session JWTs — generate: `openssl rand -hex 32`

# --- First-boot bootstrap (used once, when the DB is empty) ---
OPENKEY_ORG_NAME=Acme Inc               # Name of the org created on first boot
OPENKEY_ADMIN_EMAIL=admin@example.com   # Owner account created on first boot; its random password is printed ONCE to stdout

# --- PostgreSQL ---
POSTGRES_HOST_PORT=5432                 # Host port docker compose maps Postgres to (change if 5432 is taken locally)
REDIS_HOST_PORT=6379                    # Host port docker compose maps Redis to
POSTGRES_USER=openkey                   # Postgres superuser for the bundled container
POSTGRES_PASSWORD=change-me             # Postgres password — change it
POSTGRES_DB=openkey                     # Database name
DATABASE_URL=postgresql://openkey:change-me@postgres:5432/openkey  # Full connection string the server uses (host `postgres` inside compose, `localhost` for local dev)

# --- Redis ---
REDIS_URL=redis://redis:6379            # Redis connection string (host `redis` inside compose, `localhost` for local dev)

# --- Retention ---
OPENKEY_LOG_RETENTION_DAYS=90           # request_log/request_payload partitions older than this are dropped by the retention job
